# Stage 1: Build the Vue client
FROM node:20-bookworm AS client-builder
WORKDIR /app
COPY . .
RUN corepack enable
RUN cd src/client && (yarn install --immutable || yarn install) && yarn build

# Stage 2: Build the PHP app
FROM php:8.3-apache-bookworm

RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      git \
      unzip \
      libcurl4-openssl-dev \
      libfreetype6-dev \
      libjpeg-dev \
      libpng-dev \
      libzip-dev \
      libldap2-dev \
      libicu-dev \
      libonig-dev \
    ; \
    docker-php-ext-configure gd --with-freetype --with-jpeg; \
    docker-php-ext-configure ldap --with-libdir=lib/$(uname -m)-linux-gnu/; \
    docker-php-ext-install -j "$(nproc)" \
      curl \
      gd \
      intl \
      ldap \
      mbstring \
      opcache \
      pdo_mysql \
      zip \
    ; \
    rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY . /var/www/html/
# Copy the compiled client from stage 1
COPY --from=client-builder /app/web/dist /var/www/html/web/dist

WORKDIR /var/www/html/src
ENV COMPOSER_ALLOW_SUPERUSER=1
RUN composer install --no-dev --no-interaction --no-scripts --optimize-autoloader

WORKDIR /var/www/html
RUN { \
      echo 'opcache.memory_consumption=128'; \
      echo 'opcache.interned_strings_buffer=8'; \
      echo 'opcache.max_accelerated_files=4000'; \
      echo 'opcache.revalidate_freq=60'; \
      echo 'opcache.enable_cli=1'; \
    } > /usr/local/etc/php/conf.d/opcache-recommended.ini; \
    a2enmod rewrite; \
    chown -R www-data:www-data /var/www/html; \
    chmod -R 775 /var/www/html/lib/confs /var/www/html/src/cache /var/www/html/src/log /var/www/html/src/config
